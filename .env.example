# ── Hedera (HCS records, HTS license NFT, x402 payTo) ───────────────────────
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=                 # 0.0.x, ECDSA account; gateway treasury + x402 payTo
HEDERA_OPERATOR_KEY=                # 0x-hex ECDSA private key
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
HEDERA_USDC_TOKEN_ID=0.0.429274     # testnet USDC (mainnet: 0.0.456858)
HEDERA_REGISTRY_TOPIC_ID=           # written by scripts/hedera-bootstrap.ts
HEDERA_LICENSE_TOKEN_ID=            # written by scripts/hedera-bootstrap.ts
HEDERA_AGENT_ACCOUNT_ID=            # consuming agent's account (pays x402); written by bootstrap
HEDERA_AGENT_KEY=                   # 0x-hex ECDSA

# ── x402 via Blocky402 (Hedera track hard requirement) ──────────────────────
BLOCKY402_BASE_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet         # CAIP-2 id as Blocky402 /supported reports it
GATEWAY_PORT=4021
GATEWAY_URL=http://localhost:4021
PRICE_PER_KB_USDC=0.001             # per-call metering: price = ceil(sourceKB) * this
GATEWAY_STATE_FILE=                 # optional; default packages/gateway/data/state.json (the index; HCS is the audit log)

# ── Arc (USDC stake custody + settlement) ───────────────────────────────────
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_EXPLORER_URL=https://testnet.arcscan.app
ARC_DEPLOYER_KEY=                   # deploys SigilStake; needs Arc testnet USDC from faucet.circle.com
SIGIL_STAKE_ADDRESS=                # written by scripts/deploy.ts
SIGIL_RESOLVER_ADDRESS=             # written by scripts/deploy.ts
SEED_STAKE_USDC=                    # seed: stake this many USDC per claim instead of the fixture amounts (595 total); faucets drip ~20
SEED_ONCHAIN_SKILLS=                # seed: comma list of fixture names to escrow on Arc (e.g. cloud-helper); others stay labelled off-chain records
SEED_RUN=                           # seed: any label not used on this contract before (take2, demo-1 and demo-2 are taken; e.g. 2026-09-13); part of the claim nonce, so a repeat demo escrows fresh claims on the same contract
VERIFIER_KEY=                       # gateway key that posts sandbox verdicts to the resolver
VERIFIER_ADDRESS=
RESOLVER_KIND=                      # dispute | attestor; empty = dispute (DisputeResolver.submitVerdict vs AttestorResolver.attest)

# ── Consuming agent wallet (Circle Agent Stack) ─────────────────────────────
AGENT_WALLET_BACKEND=circle         # circle | local  (circle = Agent Stack wallet via `circle wallet execute`, verified 2026-09-12; local = viem fallback over AGENT_ARC_KEY)
CIRCLE_WALLET_ADDRESS=              # from `circle wallet list --chain ARC-TESTNET --type agent --output json` after `circle wallet login … --testnet` (RUN.md step 6)
CIRCLE_CHAIN=ARC-TESTNET            # `circle blockchain list` value for Arc testnet (chain id 5042002), verified 2026-09-12
AGENT_ARC_KEY=                      # local fallback signer (0x-hex), read only when AGENT_WALLET_BACKEND=local; needs Arc testnet USDC
AGENT_ARC_ADDRESS=
POLICY_MIN_STAKE_USDC=50            # install policy: escrowedOnArc >= this once SIGIL_STAKE_ADDRESS is set (totalStaked otherwise); the faucet-sized demo uses 10
POLICY_MIN_CLAIM_AGE_SEC=60         # and oldest claim age >= this (24h on mainnet)
POLICY_MAX_SUSTAINED_DISPUTES=0     # and sustained disputes <= this
AGENT_HUMAN_PROOF_REF=              # operator's Selfie Check nullifier; default sha256("sigil-agent-operator") in mock mode
E2E_FRESH_PAYER=                    # =1 makes `pnpm e2e` pay from a throwaway Hedera account (license NFTs make reruns free otherwise); when HEDERA_AGENT_ACCOUNT_ID holds >= 2 USDC the payer gets 2 USDC from it, so the HTS USDC leg settles (done 2026-09-12)

# ── World (Selfie Check) ────────────────────────────────────────────────────
WORLD_MODE=mock                     # sandbox | mock  (mock = clearly-labelled stub until sandbox access lands)
NEXT_PUBLIC_WORLD_APP_ID=           # app_...
NEXT_PUBLIC_WORLD_RP_ID=            # rp_...
NEXT_PUBLIC_WORLD_ACTION_ID=sigil-participant
WORLD_RP_SIGNING_KEY=               # secp256k1 private key whose address is registered as the RP signer in the Developer Portal
WORLD_PREVERIFIED_NULLIFIERS=       # sandbox mode: comma list of nullifiers the operator verified once via the web; the headless agent presents one as { nullifier }

# ── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4021
NEXT_PUBLIC_WORLD_MODE=mock

# ── Optional: dispute-input search only. Never adjudication. ────────────────
OPENAI_API_KEY=
